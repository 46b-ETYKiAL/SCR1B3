+        let mut nav = None;
+        let out = ctx.run(raw, |ctx| {
+            app.handle_keyboard_shortcuts(ctx, &mut act, &mut nav);
+        });
+        out.shapes
+            .iter()
+            .filter_map(|clipped| match &clipped.shape {
