+        let ci = include_str!("../../../../.github/workflows/ci.yml");
+        let start = ci
+            .find("\n  mutation-in-diff:")
+            .expect("the mutation-in-diff job must exist");
+        let end = start
+            + ci[start + 1..]
+                .find("\n  mutation:")
+                .expect("mutation-in-diff must be followed by the mutation job");
+        let job = &ci[start..end];
