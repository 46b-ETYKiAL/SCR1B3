+        std::fs::write(
+            v.path().join("A.md"),
+            "plain [[Old]]\nalias [[Old|The Old]]\nhead [[Old#Sec]]\nembed ![[Old]]\n",
+        )
+        .unwrap();
+        std::fs::write(v.path().join("B.md"), "unrelated [[Other]]\n").unwrap();
+        let b_before = std::fs::read_to_string(v.path().join("B.md")).unwrap();
