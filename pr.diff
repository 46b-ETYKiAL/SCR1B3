+    /// not a mutation).
+    fn page_key_assist(&mut self, ctx: &egui::Context, editor_id: egui::Id, viewport: egui::Rect) {
+        if !ctx.memory(|m| m.has_focus(editor_id)) {
+            return;
+        }
