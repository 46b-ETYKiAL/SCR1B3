+fn diag(line: u32, ch: u32, end_line: u32, end_ch: u32, severity: u8, message: &str) -> Diagnostic {
+    Diagnostic {
+        uri: "file:///qa-diagnostics.txt".into(),
+        line,
+        character: ch,
+        end_line,
+        end_character: end_ch,
+        severity,
+        message: message.into(),
+    }
