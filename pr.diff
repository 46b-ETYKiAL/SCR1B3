+            diag(2, 0, 2, 1, 1, "a"),
+            diag(11, 0, 11, 1, 1, "b"),
+        ]);
+        assert_eq!(
+            marks.iter().map(|(l, _)| *l).collect::<Vec<_>>(),
+            vec![2, 11, 30]
