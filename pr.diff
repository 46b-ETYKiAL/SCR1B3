+        // full scroll distance — the exact bug class `minimap_geometry`'s
+        // history records.
+        let panel_h = 700.0;
+        let drawn_h = 2_100.0;
+        let content_h = 200_000.0;
+        let view_h = 800.0;
+        let geom = minimap_geometry(
+            ((content_h - view_h) * 0.5, content_h, view_h),
+            panel_h,
