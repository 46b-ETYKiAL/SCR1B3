+// ---- issue classification ----
+
+#[test]
+fn a_clean_keymap_reports_no_issues() {
+    assert!(
+        issues_by_action(&Keybindings::default()).is_empty(),
+        "the shipped defaults must render with no warnings"
+    );
+}
