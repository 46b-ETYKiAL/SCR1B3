+            text,
+            doc_id: _,
+            pinned: _,
+            disk_mtime: _,
+            disk_text: _,
+            rope_state,
+            rope_buf,
+            bookmarks: _,
+            edit_gen,
+            external_change: _,
+            session_baseline: _,
+            saved_baseline: _,
+            change_states: _,
+            change_gen,
+        } = &app.tabs[idx];
