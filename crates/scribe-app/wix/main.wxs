<?xml version="1.0" encoding="windows-1252"?>
<!--
  WiX source for the SCR1B3 Windows installer (.msi), built with cargo-wix.
  Build it with `cargo wix` (package scribe-app); see packaging/README.md for
  the exact CLI flags. NOTE: XML comments may not contain a double hyphen, so
  the literal flags are described in prose here rather than written out.

  Produces target/wix/scr1b3-<version>-x86_64.msi: a standard MSI that installs
  scr1b3.exe to %LOCALAPPDATA%\Programs\SCR1B3, adds a (per-user) Start-Menu
  shortcut, and (optionally) puts it on the per-user PATH. PER-USER install (no
  admin / no UAC), so the install dir stays writable by the app — which lets the
  in-app self-updater apply updates with the silent in-place swap instead of the
  elevated installer path (see select_apply_strategy in updater.rs). Clean
  upgrade and uninstall.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
    Id="*"
    Name="SCR1B3"
    UpgradeCode="7B1C3D2E-5A4F-4E6B-9C1A-2D3E4F5A6B7C"
    Manufacturer="Itasha.Corp"
    Language="1033"
    Codepage="1252"
    Version="$(var.Version)">

    <Package Id="*"
      Keywords="Installer"
      Description="SCR1B3 — fast, telemetry-free, cross-platform code/text editor"
      Manufacturer="Itasha.Corp"
      InstallerVersion="450"
      Languages="1033"
      Compressed="yes"
      InstallScope="perUser"
      SummaryCodepage="1252" />

    <MajorUpgrade
      Schedule="afterInstallInitialize"
      DowngradeErrorMessage="A newer version of SCR1B3 is already installed. Setup will now exit." />

    <Media Id="1" Cabinet="media1.cab" EmbedCab="yes" />
    <Property Id="DiskPrompt" Value="SCR1B3 Installation" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <!-- Per-user install root: %LOCALAPPDATA%\Programs\SCR1B3 (the same
           convention VS Code / Squirrel / Velopack use). Writable by the app,
           so the in-app updater can self-replace in place without elevation. -->
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsFolder" Name="Programs">
          <Directory Id="APPLICATIONFOLDER" Name="SCR1B3">
            <Component Id="MainExecutable" Guid="*">
              <File Id="scr1b3.exe"
                Name="scr1b3.exe"
                DiskId="1"
                Source="$(var.CargoTargetBinDir)\scr1b3.exe"
                KeyPath="yes" />
              <!-- Optional PATH entry (per-user, no admin). -->
              <Environment Id="PATH"
                Name="PATH"
                Value="[APPLICATIONFOLDER]"
                Permanent="no"
                Part="last"
                Action="set"
                System="no" />
              <!--
                Uninstall directory cleanup, stated explicitly instead of being
                left to the installer's implicit empty-directory sweep.

                Both directories are created by this package inside the user
                profile, which is exactly what ICE64 flags when they are absent
                from the RemoveFile table. Authoring them is what lets the
                msi-build CI job stop suppressing ICE64, so a FUTURE edit that
                adds an uncleaned user-profile directory is caught instead of
                silently waved through.

                Measured, not assumed: on Windows 11 an uninstall already
                removed both directories without these rows, so this is not a
                repair of a leak that was happening. What it buys is that the
                cleanup is now a declared part of the package rather than a
                behaviour of the installer, and that the ICE stays enabled.

                Removal is EMPTY-ONLY: a RemoveFile folder row deletes the
                directory only when nothing is left in it. So the SHARED
                %LOCALAPPDATA%\Programs directory survives whenever any other
                per-user app (VS Code, Obsidian, ...) still lives there, and
                anything the in-app self-updater leaves in the install
                directory likewise keeps that directory. Verified against a
                package carrying these rows with a foreign occupant planted in
                the parent: the occupant and its directory were untouched.

                Deeper directory first, because the rows are processed in table
                order: SCR1B3 has to be emptied before Programs is tested.
              -->
              <RemoveFolder Id="RemoveApplicationFolder"
                Directory="APPLICATIONFOLDER"
                On="uninstall" />
              <RemoveFolder Id="RemoveProgramsFolder"
                Directory="ProgramsFolder"
                On="uninstall" />
            </Component>

            <!--
              File associations (HKCU, per-user, no admin).

              GENERATED from the app's own registry_entries builder and pinned by
              wix_installer_registers_what_the_app_registers in
              src/integration/mod.rs: the installer and the in-app registration
              write the SAME key/name/value set, so a fresh MSI leaves SCR1B3
              already present in Open-with and Default Apps instead of doing
              nothing until the user visits Settings. Because these rows are
              authored by the MSI they are also REMOVED on uninstall, which the
              app's own runtime writes never are.

              The exe path is the [APPLICATIONFOLDER] property token; the app
              writes the identical keys with the resolved absolute path, so the
              two converge rather than conflict. Do not hand-edit: regenerate and
              let the drift test confirm parity.
            -->
            <Component Id="FileAssociations" Guid="*">
              <RegistryValue Root="HKCU" Key="Software\SCR1B3\Capabilities" Name="ApplicationName" Value="SCR1B3" Type="string" KeyPath="yes" />
              <RegistryValue Root="HKCU" Key="Software\SCR1B3\Capabilities" Name="ApplicationDescription" Value="Fast, telemetry-free code &amp; text editor." Type="string" KeyPath="no" />
              <RegistryValue Root="HKCU" Key="Software\RegisteredApplications" Name="SCR1B3" Value="Software\SCR1B3\Capabilities" Type="string" KeyPath="no" />
              <RegistryValue Root="HKCU" Key="Software\Classes\Applications\scr1b3.exe" Name="FriendlyAppName" Value="SCR1B3" Type="string" KeyPath="no" />
              <RegistryValue Root="HKCU" Key="Software\Classes\Applications\scr1b3.exe\shell\open\command" Value="&quot;[APPLICATIONFOLDER]scr1b3.exe&quot; &quot;%1&quot;" Type="string" KeyPath="no" />
              <RegistryValue Root="HKCU" Key="Software\Classes\*\shell\SCR1B3" Value="Edit with SCR1B3" Type="string" KeyPath="no" />
              <RegistryValue Root="HKCU" Key="Software\Classes\*\shell\SCR1B3" Name="Icon" Value="[APPLICATIONFOLDER]scr1b3.exe,0" Type="string" KeyPath="no" />
              <RegistryValue Root="HKCU" Key="Software\Classes\*\shell\SCR1B3\command" Value="&quot;[APPLICATIONFOLDER]scr1b3.exe&quot; &quot;%1&quot;" Type="string" KeyPath="no" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SCR1B3.txt\shell\open\command" Value="&quot;[APPLICATIONFOLDER]scr1b3.exe&quot; &quot;%1&quot;" Type="string" KeyPath="no" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SCR1B3.txt\DefaultIcon" Value="[APPLICATIONFOLDER]scr1b3.exe,0" Type="string" KeyPath="no" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SCR1B3.txt" Value="SCR1B3 document" Type="string" KeyPath="no" />
              <RegistryValue Root="HKCU" Key="Software\Classes\.txt\OpenWithProgids" Name="SCR1B3.txt" Value="" Type="string" KeyPath="no" />
              <RegistryValue Root="HKCU" Key="Software\SCR1B3\Capabilities\FileAssociations" Name=".txt" Value="SCR1B3.txt" Type="string" KeyPath="no" />
              <RegistryValue Root="HKCU" Key="Software\Classes\Applications\scr1b3.exe\SupportedTypes" Name=".txt" Value="" Type="string" KeyPath="no" />
              <RegistryValue Root="HKCU" Key="Software\Classes\.txt" Name="PerceivedType" Value="text" Type="string" KeyPath="no" />
              <RegistryValue Root="HKCU" Key="Software\Classes\.text\OpenWithProgids" Name="SCR1B3.txt" Value="" Type="string" KeyPath="no" />
              <RegistryValue Root="HKCU" Key="Software\SCR1B3\Capabilities\FileAssociations" Name=".text" Value="SCR1B3.txt" Type="string" KeyPath="no" />
              <RegistryValue Root="HKCU" Key="Software\Classes\Applications\scr1b3.exe\SupportedTypes" Name=".text" Value="" Type="string" KeyPath="no" />
              <RegistryValue Root="HKCU" Key="Software\Classes\.text" Name="PerceivedType" Value="text" Type="string" KeyPath="no" />
              <RegistryValue Root="HKCU" Key="Software\Classes\.log\OpenWithProgids" Name="SCR1B3.txt" Value="" Type="string" KeyPath="no" />
              <RegistryValue Root="HKCU" Key="Software\SCR1B3\Capabilities\FileAssociations" Name=".log" Value="SCR1B3.txt" Type="string" KeyPath="no" />
              <RegistryValue Root="HKCU" Key="Software\Classes\Applications\scr1b3.exe\SupportedTypes" Name=".log" Value="" Type="string" KeyPath="no" />
              <RegistryValue Root="HKCU" Key="Software\Classes\.log" Name="PerceivedType" Value="text" Type="string" KeyPath="no" />
              <RegistryValue Root="HKCU" Key="Software\Classes\.nfo\OpenWithProgids" Name="SCR1B3.txt" Value="" Type="string" KeyPath="no" />
              <RegistryValue Root="HKCU" Key="Software\SCR1B3\Capabilities\FileAssociations" Name=".nfo" Value="SCR1B3.txt" Type="string" KeyPath="no" />
