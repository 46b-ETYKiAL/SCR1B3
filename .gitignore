# Rust build output
/target
**/*.rs.bk
Cargo.lock.bak

# SCR1B3 ships as a binary/app, so its lockfile MUST be committed for
# reproducible + `--locked` CI builds. Override the monorepo-root ignore.
!Cargo.lock

# Secrets / signing keys — NEVER commit
*.key
*.pem
*.minisig.sec
minisign.key
signing/*.sec

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Editor/IDE local
.idea/
.vscode/
*.swp

# Local runtime
*.log
/scr1b3.toml.local

# Tooling runtime state — must never enter the public repo.
# Matched by shape rather than by name, so this file does not itself publish
# the internal directory names the content-safety audit exists to suppress.
.*-data/
/mutants.out*/

# Python bytecode (scripts/ helpers are run in-place)
__pycache__/
*.pyc

# Mutation-run scratch (agent analysis logs; mutants.out* already ignored above)
/.mutlogs/
